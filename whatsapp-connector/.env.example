PORT=3001

# Secret partagé avec Laravel (config/services.php -> whatsapp_connector.secret,
# variable WHATSAPP_CONNECTOR_SECRET côté Laravel). Doit être une valeur longue et aléatoire,
# identique des deux côtés — jamais exposée au frontend.
CONNECTOR_SECRET=change-me

# URL du webhook Laravel qui reçoit les changements de statut (connecté/déconnecté/numéro).
LARAVEL_WEBHOOK_URL=https://controool.fr/api/webhooks/whatsapp-connector
